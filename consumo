using System;
using System.Threading.Tasks;
using Firebase.Database;
using Firebase.Database.Query;

class Program
{
    static async Task Main(string[] args)
    {
        // URL do seu Firebase Realtime Database
        var firebase = new FirebaseClient("https://powermanager-988cc-default-rtdb.firebaseio.com/");
        
        // ID do usuário e dispositivo baseado na estrutura mostrada
        string userId = "VX0Ud3jgCPTdGZrutzn6Sp9tlGO2";
        string deviceName = "esp32";
        
        Console.WriteLine("Monitorando leituras do ESP32...");
        Console.WriteLine($"Usuário: {userId}");
        Console.WriteLine($"Dispositivo: {deviceName}");
        Console.WriteLine("Pressione Enter para sair.\n");

        // Escuta mudanças no campo numero (potência) do ESP32
        var observable = firebase
            .Child("users")
            .Child(userId)
            .Child("devices")
            .Child(deviceName)
            .Child("numero")
            .AsObservable<double>()
            .Subscribe(async leitura =>
            {
                try
                {
                    if (leitura.Object != null)
                    {
                        double potencia = leitura.Object;
                        
                        // Calcula energia consumida em 5s (assumindo leituras a cada 5s)
                        // Fórmula: Energia (kWh) = Potência (W) × Tempo (h) / 1000
                        double energia5s = potencia * (5.0 / 3600.0) / 1000.0; // 5 segundos = 5/3600 horas
                        
                        // Caminho para o consumo total acumulado
                        var consumoTotalRef = firebase
                            .Child("users")
                            .Child(userId)
                            .Child("devices")
                            .Child(deviceName)
                            .Child("consumo_total");
                        
                        // Lê o valor atual do consumo acumulado
                        var totalSnap = await consumoTotalRef.OnceSingleAsync<double?>();
                        double acumulado = totalSnap ?? 0.0; // Se não existir, inicia com 0
                        
                        // Adiciona o novo consumo ao acumulado
                        acumulado += energia5s;
                        
                        // Atualiza o consumo total no Firebase
                        await consumoTotalRef.PutAsync(acumulado);
                        
                        // Também salva um log da leitura atual com timestamp
                        string timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
                        var logRef = firebase
                            .Child("users")
                            .Child(userId)
                            .Child("devices")
                            .Child(deviceName)
                            .Child("historico")
                            .Child(DateTime.Now.ToString("yyyyMMdd_HHmmss"));
                        
                        await logRef.PutAsync(new
                        {
                            timestamp = timestamp,
                            potencia_w = potencia,
                            energia_kwh = energia5s,
                            total_acumulado = acumulado
                        });
                        
                        // Exibe informações no console
                        Console.WriteLine($"[{timestamp}] Potência: {potencia:F2} W | " +
                                        $"Energia 5s: {energia5s:F6} kWh | " +
                                        $"Total Acumulado: {acumulado:F6} kWh");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Erro ao processar leitura: {ex.Message}");
                }
            });

        // Mantém o programa rodando
        Console.ReadLine();
        
        // Cleanup
        observable?.Dispose();
        Console.WriteLine("Monitoramento encerrado.");
    }
}